NEXT_PUBLIC_API_BASE=http://localhost:8002

# Where product photos are served from (the backend sends full URLs from
# here). Only this host is allowed through the image optimizer.
NEXT_PUBLIC_PRODUCT_IMAGE_BASE_URL=https://YOUR-PROJECT-REF.supabase.co/storage/v1/object/public/product-images

# Public URL of the storefront (canonical links, sitemap, structured data).
# Required for production builds — the public https origin, e.g. https://www.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional, server-only: how the Next.js server reaches the storefront API if
# that differs from the browser URL above (e.g. a private network address).
# API_INTERNAL_BASE=
