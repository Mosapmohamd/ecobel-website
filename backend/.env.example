# MUST be the SAME database ecobel-accounting-system uses — this service
# reads/writes the shared categories/products/inventory_movements/
# finance_entries tables directly. Falls back to a local SQLite file if
# unset (development/testing only).
#
# For local dev, point BOTH services' DATABASE_URL at the exact same
# file — e.g.:
#   DATABASE_URL=sqlite:////absolute/path/to/shared/ecobel_shared_dev.db
DATABASE_URL=postgresql://ecobel_user:CHANGE_ME@localhost:5432/ecobel_db

# Signs customer login tokens — a random value of 32+ characters in
# production. Should be a DIFFERENT value from the accounting system's
# SECRET_KEY (separate token namespaces — a customer token must never be
# accepted by the accounting API or vice versa).
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET

# Comma-separated list of allowed frontend origins for CORS.
FRONTEND_ORIGINS=https://ecobel-eg.com,https://www.ecobel-eg.com

# Product photos are served from Supabase Storage; this service only builds
# their public URLs (no secret needed). Must match ecobel-accounting-system.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# PRODUCT_IMAGES_BUCKET=product-images
# PRODUCT_IMAGE_BASE_URL=   # optional: public base URL override (e.g. a CDN)

# "production" turns on strict mode: no public API docs (/docs, /openapi.json),
# HSTS, and startup is refused unless DATABASE_URL is PostgreSQL (not SQLite),
# SECRET_KEY is a random value of 32+ characters and FRONTEND_ORIGINS lists
# only https origins (no localhost).
# Behind a hosting platform's proxy, start uvicorn with --proxy-headers and
# --forwarded-allow-ips set to the platform's private ranges (see the start
# command in render.yaml) so rate limits see each visitor's real address —
# never --forwarded-allow-ips="*", which lets clients fake their address.
ENVIRONMENT=development
